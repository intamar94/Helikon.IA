NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Marketplace de drones (/marketplace).
# Sin esta variable el marketplace corre contra un store en memoria sembrado
# con lib/marketplace/seed-data.ts — útil para la demo, volátil por diseño.
# Con 'supabase' usa las tablas mkt_* (aplicar supabase/marketplace_schema.sql
# y supabase/marketplace_seed.sql antes).
# MARKETPLACE_DATA_SOURCE=supabase
# Opcional: para que el panel admin escriba salteando RLS.
# SUPABASE_SERVICE_ROLE_KEY=
